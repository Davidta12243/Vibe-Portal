# ==============================================================================
# VIBE PORTAL - URL CÁC PHÂN HỆ CON TRÊN VERCEL
# Nếu không cấu hình, hệ thống sẽ tự động fallback về localhost:3001 đến 3006
# Khi deploy Portal lên Vercel: điền các URL tương ứng vào Vercel > Settings > Environment Variables
# ==============================================================================

# 1. Web Shop (Shopee Clone)
VITE_APP_SHOP_URL=https://vibe-shop-demo.vercel.app

# 2. Web Food / Nông sản (Sendo Farm Clone)
VITE_APP_FOOD_URL=https://vibe-food-demo.vercel.app

# 3. Web PC Builder (Phúc Anh Clone)
VITE_APP_PC_URL=https://vibe-pc-demo.vercel.app

# 4. Web Travel / Booking (Traveloka Clone)
VITE_APP_TRAVEL_URL=https://vibe-travel-demo.vercel.app

# 5. Web LMS / Khóa học (Hocmai Clone) - Tạm để trống hoặc localhost:3005
VITE_APP_EDU_URL=http://localhost:3005

# 6. Web Livestream Studio
VITE_APP_LIVESTREAM_URL=https://vibe-livestream-demo.vercel.app
